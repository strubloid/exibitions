# ─── App ──────────────────────────────────────────
APP_NAME=
APP_ENV=
APP_DEBUG=
APP_URL=
APP_TIMEZONE=
APP_LOCALE=

# ─── Database (local docker-compose) ─────────────
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ─── Database (fly.io production — set automatically by postgres attach) ───
DATABASE_URL=

# ─── Postgres container ───────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ─── Session / Cache ──────────────────────────────
SESSION_DRIVER=
SESSION_LIFETIME=
CACHE_STORE=
QUEUE_CONNECTION=

# ─── Mail ─────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# ─── Logging ──────────────────────────────────────
LOG_CHANNEL=
LOG_LEVEL=

# ─── Admin Side  ───────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Buy-art checkout (v1) ─────────────────────────
# Stripe keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Public frontend URL — used to constrain the checkout success_url (open-redirect guard)
# and to build the cancel_url. Must match the URL the buyer's browser sees.
FRONTEND_URL=http://localhost:8080

# ─── Print-on-demand fulfilment (v1.5 — leave blank if not used yet) ───
# Printful personal access token from https://www.printful.com/dashboard/settings/API
PRINTFUL_TOKEN=
PRINTFUL_WEBHOOK_SECRET=